---
import Layout from '../layouts/Layout.astro';
import { profile, projects } from '../data/portfolio';
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Systems · Markets · Machine learning</p>
      <h1 id="hero-title">Yuming<br /><span>Wang.</span></h1>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-links">
        <a class="button primary" href="#projects">Explore my work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={profile.resume}>View résumé <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="portrait">
      <img src="/images/profile.jpg" alt="Portrait of Yuming Wang" width="1045" height="1567" fetchpriority="high" />
      <figcaption><span>Computer Science × Finance</span><span aria-hidden="true">[ YW / 01 ]</span></figcaption>
    </figure>
    <div class="hero-footnote"><span>{profile.education}</span><a href="#about">Get to know me <span aria-hidden="true">↓</span></a></div>
  </section>

  <section id="about" class="about section wrap" aria-labelledby="about-title">
    <div class="section-heading"><p class="eyebrow">01 / About</p><h2 id="about-title">Curious about markets.<br />Driven by engineering.</h2></div>
    <div class="about-content">
      <p class="lead">I’m Yu-Ming Wang, a Computer Science master’s student at New York University with a dual background in Computer Science and Quantitative Finance.</p>
      <p>I’m drawn to problems where every engineering decision matters: how an order is matched, how a simulator handles concurrency, or how a model learns from financial data. I’ve built custom matching engines in C++, engineered multithreaded simulators, and worked on system performance down to the cache line.</p>
      <p>Alongside systems work, I bring experience in machine learning, large language models, and data preprocessing—from maintaining trader models to cleaning and structuring datasets for backtesting and strategy exploration.</p>
      <div class="expertise" aria-label="Areas of focus"><span>Performance-minded systems</span><span>Machine learning</span><span>Financial data pipelines</span></div>
    </div>
  </section>

  <section id="projects" class="work section wrap" aria-labelledby="work-title">
    <div class="section-heading work-heading"><div><p class="eyebrow">02 / Selected work</p><h2 id="work-title">Ideas, built into systems.</h2></div><a class="text-link" href={profile.github}>GitHub profile <span aria-hidden="true">↗</span></a></div>
    <div class="project-list">
      {projects.map(project => (
        <a class="project-row" href={`/projects/${project.slug}/`}>
          <span class="project-number">{project.number}</span>
          <div class="project-main"><p class="eyebrow">{project.category}</p><h3>{project.title}</h3><p>{project.summary}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul></div>
          <span class="project-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section id="contact" class="contact section wrap" aria-labelledby="contact-title">
    <p class="eyebrow">03 / Get in touch</p>
    <h2 id="contact-title">Let’s build<br /><span>something thoughtful.</span></h2>
    <p>Working on trading infrastructure, intelligent models, or a challenging systems problem? I’d love to connect.</p>
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
    <div class="social-links"><a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}>GitHub ↗</a><a href={profile.resume}>Résumé ↗</a></div>
  </section>
</Layout>
