---
import Layout from '../layouts/Layout.astro';
import ArtComposition from '../components/ArtComposition.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import { profile, projects } from '../data/portfolio';
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">Yuming Wang <span aria-hidden="true">/</span> Engineering & exploration</p>
      <h1 id="hero-title">Precision,<br /><span>with perspective.</span></h1>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-links">
        <a class="button primary" href="#projects">Explore my work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={profile.resume}>View résumé <span aria-hidden="true">↗</span></a>
      </div>
      <div class="current-role"><span class="mini-label">Currently at</span><strong>{profile.company}</strong><span>{profile.jobTitle}</span></div>
    </div>
    <ArtComposition />
    <div class="hero-footnote"><span>C++ <span aria-hidden="true">/</span> Compilers <span aria-hidden="true">/</span> AI accelerators</span><a href="#focus">A closer look <span aria-hidden="true">↓</span></a></div>
  </section>

  <section id="focus" class="focus section wrap" aria-labelledby="focus-title">
    <div class="section-heading"><p class="eyebrow">01 / Engineering focus</p><h2 id="focus-title">From model graphs<br />to efficient execution.</h2><p class="section-intro">Working across the software stack, with a growing interest in where AI execution meets quantitative systems.</p></div>
    <div class="focus-grid">
      <article class="focus-card"><span class="focus-index">[ 01 ]</span><p class="mini-label">Current work</p><h3>AI frameworks<br />& compilers</h3><p>Developing AI framework software and ML accelerator compilers. Understanding large codebases and how models map to accelerator hardware.</p><div class="focus-bottom">Model graphs → Hardware</div></article>
      <article class="focus-card"><span class="focus-index">[ 02 ]</span><p class="mini-label">Engineering practice</p><h3>Performance<br />at the system level</h3><p>High-performance C++, low-level problem solving, and performance optimization. Building a deeper understanding of memory behavior and computer architecture.</p><div class="focus-bottom">C++ / Architecture / Optimization</div></article>
      <article class="focus-card"><span class="focus-index">[ 03 ]</span><p class="mini-label">Exploring next</p><h3>Quant runtimes<br />& low-latency inference</h3><p>Interested in efficient quantitative model execution, inference latency, and the performance-critical infrastructure behind quantitative and high-frequency trading.</p><div class="focus-bottom">Model inference → Trading systems</div></article>
    </div>
  </section>

  <section id="projects" class="work section wrap" aria-labelledby="work-title">
    <div class="section-heading work-heading"><div><p class="eyebrow">02 / Selected projects</p><h2 id="work-title">Where ideas become systems.</h2></div><a class="text-link" href={profile.github}>GitHub profile <span aria-hidden="true">↗</span></a></div>
    <div class="project-grid">
      {projects.map(project => (
        <a class={`project-card project-${project.slug}`} href={`/projects/${project.slug}/`}>
          <div class="project-visual"><ProjectArtwork variant={project.slug} /><span class="artwork-number" aria-hidden="true">{project.number}</span></div>
          <div class="project-card-body"><p class="eyebrow">Project {project.number}</p><h3>{project.title}</h3><p>{project.summary}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul><span class="project-cta">Explore project <span aria-hidden="true">↗</span></span></div>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="about section wrap" aria-labelledby="about-title">
    <div class="about-sidebar"><p class="eyebrow">03 / About me</p><figure class="portrait"><img src="/images/profile.jpg" alt="Portrait of Yuming Wang" width="1045" height="1567" loading="lazy" /><figcaption><strong>{profile.name}</strong><span>{profile.role}</span></figcaption></figure><div class="education-note"><span class="mini-label">Education</span><p>{profile.education}</p><span>{profile.background}</span></div></div>
    <div class="about-content"><h2 id="about-title">An engineer’s mindset.<br /><span>A quantitative foundation.</span></h2>{profile.about.map((paragraph, index) => <p class={index === 0 ? 'lead' : undefined}>{paragraph}</p>)}<a class="text-link" href={profile.linkedin}>Connect on LinkedIn <span aria-hidden="true">↗</span></a></div>
  </section>

  <section id="contact" class="contact section wrap" aria-labelledby="contact-title">
    <div><p class="eyebrow">04 / Let’s connect</p><h2 id="contact-title">Good systems start<br />with a conversation.</h2><p>AI compilers, model runtimes, or low-latency systems—always happy to exchange ideas.</p></div>
    <div class="contact-actions"><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a><button class="copy-email" type="button" data-email={profile.email} hidden>Copy email <span aria-hidden="true">⧉</span></button><span class="copy-status" role="status"></span><div class="social-links"><a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}>GitHub ↗</a><a href={profile.resume}>Résumé ↗</a></div></div>
  </section>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
    const status = document.querySelector<HTMLElement>('.copy-status');
    if (copyButton && navigator.clipboard) {
      copyButton.hidden = false;
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyButton.dataset.email || '');
          if (status) status.textContent = 'Email copied to clipboard.';
        } catch {
          if (status) status.textContent = 'Couldn’t copy. You can select the email address above.';
        }
      });
    }
  </script>
</Layout>
