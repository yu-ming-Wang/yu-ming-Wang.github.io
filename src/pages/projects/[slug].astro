---
import Layout from '../../layouts/Layout.astro';
import { profile, projects } from '../../data/portfolio';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<Layout title={`${project.title} — ${profile.name}`} description={project.summary}>
  <article class="project-detail wrap">
    <a class="text-link" href="/#projects">← Back to selected work</a>
    <p class="eyebrow">{project.number} / {project.category}</p>
    <h1>{project.title}</h1>
    <p class="lead">{project.summary}</p>
    <ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    <div class="detail-body">
      <section aria-labelledby="overview-title"><h2 id="overview-title">Overview</h2><p>{project.overview}</p></section>
      <section aria-labelledby="context-title"><h2 id="context-title">Context</h2><p>{project.context}</p></section>
    </div>
    <aside class="project-note">
      <h2>Want to discuss the project?</h2>
      <p>Get in touch for more context about the work and implementation.</p>
      <a class="button primary" href={project.repository || `mailto:${profile.email}?subject=${encodeURIComponent(project.title)}`}>{project.repository ? 'View repository ↗' : 'Ask about this project ↗'}</a>
    </aside>
  </article>
</Layout>
